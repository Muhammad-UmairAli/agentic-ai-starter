# Copy to .env.local (gitignored) and fill in. Never commit real values.

# --- Branding (white-label) ---
NEXT_PUBLIC_BRAND_NAME="Acme Community"
NEXT_PUBLIC_APP_VERSION=0.1.0

# --- AI provider (Anthropic) ---
# Leave empty to run the deterministic offline mock.
ANTHROPIC_API_KEY=
# Optional overrides
AI_MODEL=claude-opus-5-5
# AI_MODE=mock               # force the mock even when a key is set
# AI_MODERATION_ENABLED=false # ops kill switch: skip only the AI classifier step

# --- GitHub feedback intake ---
# Fine-grained PAT for a bot account: Issues read/write and Contents read on GITHUB_REPO only.
# Leave empty for dry-run previews.
GITHUB_TOKEN=
GITHUB_REPO=your-org/your-repo
GITHUB_CHANGELOG_BRANCH=main
# Comma-separated hostnames allowed for screenshot URLs embedded in issues.
ATTACHMENT_HOSTS=
